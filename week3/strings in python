        "def reverse_numbers(n):\n",
        "  reverse=0\n",
        "\n",
        "  while n>0:\n",
        "    digit=n%10\n",
        "    reverse=reverse*10+digit\n",
        "    n=n//10\n",
        "  return reverse\n",
